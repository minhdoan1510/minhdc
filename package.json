{
  "name": "profile-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual personal blog for Hà Lê Nguyên — Astro SSR on Cloudflare Workers + D1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "^6.0.4",
    "@editorjs/attaches": "1.3.2",
    "@editorjs/code": "2.9.4",
    "@editorjs/delimiter": "1.4.2",
    "@editorjs/editorjs": "2.31.6",
    "@editorjs/embed": "2.8.0",
    "@editorjs/header": "2.8.9",
    "@editorjs/image": "2.10.3",
    "@editorjs/inline-code": "1.5.2",
    "@editorjs/link": "2.6.2",
    "@editorjs/list": "2.0.9",
    "@editorjs/marker": "1.4.0",
    "@editorjs/paragraph": "2.11.7",
    "@editorjs/personality": "2.0.2",
    "@editorjs/quote": "2.7.6",
    "@editorjs/raw": "2.5.1",
    "@editorjs/simple-image": "1.6.0",
    "@editorjs/table": "2.4.6",
    "@editorjs/text-variant-tune": "1.0.3",
    "@editorjs/underline": "1.2.1",
    "@editorjs/warning": "1.4.1",
    "astro": "^7.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^7.0.2",
    "wrangler": "4.149.0"
  }
}
